# Copy to .env.local and fill in. .env.local is git-ignored — never commit secrets.
# src/lib/env.ts validates these at startup and fails fast with the bad names.

# --- Auth (SETUP.md §1) ---
# openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_GOOGLE_ID=replace-me.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=replace-me
ALLOWED_EMAIL_DOMAIN=thinkvibes.com
# Comma-separated. These users see /admin.
ADMIN_EMAILS=someone@thinkvibes.com,other@thinkvibes.com

# --- App ---
# http://localhost:3000 in development. Baked in at build time.
NEXT_PUBLIC_APP_URL=https://scan.thinkvibes.com

# --- Gemini OCR ---
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Salesforce (SETUP.md §2) ---
# The org's My Domain URL, not login.salesforce.com.
SF_LOGIN_URL=https://replace-me.my.salesforce.com
SF_CLIENT_ID=replace-me
SF_CLIENT_SECRET=replace-me
SF_API_VERSION=v60.0
SF_CAMPAIGN_ID=701replaceme

# --- Event ---
EVENT_SLUG=dreamforce-2026
CONSENT_TEXT_VERSION=v1

# --- Phase 2 only (leave unset in Phase 1) ---
# openssl rand -hex 32
SYNC_SECRET=
MONGODB_URI=
MONGODB_DB=snapcard
